# Public Google OAuth Web client ID. This value is embedded into the frontend build.
VITE_GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# Production API base URL, including /api. Leave unset for local development proxy.
VITE_API_BASE_URL=https://api.example.com/api

# Optional marker rendered on the start screen.
VITE_BUILD_MARK=2026-07-google-auth
