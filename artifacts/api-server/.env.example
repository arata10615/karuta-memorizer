# Google OAuth Web client ID. Must match the client ID used by the frontend.
GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com

# Random secret of at least 32 characters. Never expose this value to the frontend.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Comma-separated frontend origins permitted to call this API.
WEB_ORIGIN=https://karuta-memorizer.pages.dev

# Neon Postgres connection string.
DATABASE_URL=postgresql://...

# Optional: defaults to 3000.
PORT=3000
